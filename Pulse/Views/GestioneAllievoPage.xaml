<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.GestioneAllievoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Pulse.Models"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    x:Name="PageRoot"
    Title="Gestione Allievo"
    x:DataType="vm:GestioneAllievoViewModel"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <!--  DATI ANAGRAFICI  -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Nome:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Placeholder="Es. Mario"
                            Text="{Binding Nome}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Cognome:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Placeholder="Es. Rossi"
                            Text="{Binding Cognome}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!--  SESSO E DATA DI NASCITA  -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Sesso:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Picker
                            Title="Seleziona"
                            ItemsSource="{Binding OpzioniSesso}"
                            SelectedItem="{Binding Sesso}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Data di Nascita:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <DatePicker
                            Date="{Binding DataNascita}"
                            Format="dd/MM/yyyy"
                            HeightRequest="42" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label
                FontAttributes="Bold"
                Text="Codice Fiscale:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="42"
                    Placeholder="Es. RSSMRA80A01H501U"
                    Text="{Binding CodiceFiscale}" />
            </Border>

            <!--  INDIRIZZO E N. CIVICO  -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Indirizzo:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Placeholder="Es. Via Roma"
                            Text="{Binding Indirizzo}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="N. Civico:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Placeholder="Es. 12"
                            Text="{Binding NCivico}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!--  CAP E CITTÀ  -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="CAP:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Keyboard="Numeric"
                            Placeholder="Es. 63074"
                            Text="{Binding Cap}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Città:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Placeholder="Es. San Benedetto del Tronto"
                            Text="{Binding Citta}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!--  PROVINCIA E CELLULARE  -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Provincia:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            MaxLength="2"
                            Placeholder="Es. AP"
                            Text="{Binding Provincia}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Cellulare:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Keyboard="Telephone"
                            Placeholder="Es. 333 1234567"
                            Text="{Binding Cellulare}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Telefono:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Keyboard="Telephone"
                            Text="{Binding Telefono}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="Email:"
                        TextColor="#1E293B" />
                    <Border
                        Padding="10,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="42"
                            Keyboard="Email"
                            Text="{Binding Email}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!--  NOTE / ALLEGATI  -->
            <Label
                FontAttributes="Bold"
                Text="Note / Allegati:"
                TextColor="#1E293B" />
            <Border
                Padding="10"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Editor
                    HeightRequest="70"
                    Placeholder="Note aggiuntive, riferimenti a certificati o documenti allegati..."
                    Text="{Binding Allegati}" />
            </Border>

            <!--  ================= TABELLA STORICO ABBONAMENTI =================  -->
            <Border
                Margin="0,10,0,0"
                Padding="0"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="0">

                    <!--  INTESTAZIONE SEZIONE E TASTO NUOVO  -->
                    <Grid
                        Padding="15,12"
                        BackgroundColor="#F8FAFC"
                        ColumnDefinitions="*, Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="💳 Storico Abbonamenti"
                            TextColor="#1E293B"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1"
                            Padding="12,0"
                            BackgroundColor="#10B981"
                            Command="{Binding ApriPopupNuovoAbbonamentoCommand}"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="36"
                            Text="+ Nuovo Abbonamento"
                            TextColor="White" />
                    </Grid>

                    <BoxView BackgroundColor="#E2E8F0" HeightRequest="1" />

                    <!--  BARRA DI RICERCA E FILTRO PER ANNO  -->
                    <Grid
                        Padding="12"
                        ColumnDefinitions="2*, 1*"
                        ColumnSpacing="12">
                        <Border
                            Grid.Column="0"
                            Padding="8,0"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 8">
                            <SearchBar
                                HeightRequest="42"
                                Placeholder="🔍 Cerca per corso o tipologia..."
                                Text="{Binding TestoRicercaAbbonamento}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 8">
                            <Picker
                                Title="Seleziona Anno"
                                Margin="10,0"
                                ItemsSource="{Binding AnniDisponibili}"
                                SelectedItem="{Binding AnnoSelezionato}"
                                TextColor="#1E293B"
                                TitleColor="#64748B" />
                        </Border>
                    </Grid>

                    <!--  HEADER TABELLA (Azioni a 260px)  -->
                    <Grid
                        Padding="16,10"
                        BackgroundColor="#F1F5F9"
                        ColumnDefinitions="2*, 1.2*, 1*, 1*, 260"
                        ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="Corso / Tipo"
                            TextColor="#475569" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="Periodo"
                            TextColor="#475569" />
                        <Label
                            Grid.Column="2"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="Importo"
                            TextColor="#475569" />
                        <Label
                            Grid.Column="3"
                            FontAttributes="Bold"
                            FontSize="11"
                            Text="Stato"
                            TextColor="#475569" />
                        <Label
                            Grid.Column="4"
                            FontAttributes="Bold"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            Text="Azioni"
                            TextColor="#475569" />
                    </Grid>

                    <BoxView BackgroundColor="#E2E8F0" HeightRequest="1" />

                    <!--  RIGHE TABELLA (x:DataType="x:Object" garantisce la risoluzione dei Command con x:Reference)  -->
                    <CollectionView ItemsSource="{Binding ListaAbbonamentiPaginata}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                Padding="20"
                                HorizontalOptions="Center"
                                Spacing="6">
                                <Label
                                    FontSize="30"
                                    HorizontalOptions="Center"
                                    Text="📄" />
                                <Label
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="Nessun abbonamento registrato per i filtri selezionati."
                                    TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <Border
                                    Padding="16,10"
                                    Stroke="#F1F5F9"
                                    StrokeThickness="0.5">
                                    <!--  regolazione perfetta "2.8*, 2*, 1.5*, 1.1*, 350" non toccare mai  -->
                                    <Grid
                                        ColumnDefinitions="2.8*, 2*, 1.5*, 1.1*, 350"
                                        ColumnSpacing="4"
                                        VerticalOptions="Center">

                                        <!--  Corso e Tipologia  -->
                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="1"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="13"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Corso.Nome}"
                                                TextColor="#1E293B" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding TipoAbbonamento}"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <!--  Date Inizio e Fine  -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="1"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="11"
                                                Text="{Binding DataInizio, StringFormat='Inizio: {0:dd/MM/yy}'}"
                                                TextColor="#64748B" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding DataScadenza, StringFormat='Fine: {0:dd/MM/yy}'}"
                                                TextColor="#334155" />
                                        </VerticalStackLayout>

                                        <!--  Importo  -->
                                        <Label
                                            Grid.Column="2"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding ImportoTotale, StringFormat='€ {0:N2}'}"
                                            TextColor="#10B981"
                                            VerticalOptions="Center" />

                                        <!--  Badge Stato  -->
                                        <Border
                                            Grid.Column="3"
                                            Padding="6,2"
                                            BackgroundColor="{Binding ColoreStatoHex}"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                Text="{Binding StatoTesto}"
                                                TextColor="White" />
                                        </Border>

                                        <!--  Azioni con binding esplicito a PageRoot  -->
                                        <HorizontalStackLayout
                                            Grid.Column="4"
                                            HorizontalOptions="Center"
                                            Spacing="6"
                                            VerticalOptions="Center">

                                            <!--  Storico completo degli abbonamenti di questo corso  -->
                                            <Button
                                                Padding="0"
                                                BackgroundColor="#EDE9FE"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApriStoricoAbbonamentiCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontSize="13"
                                                HeightRequest="32"
                                                Text="📋"
                                                WidthRequest="32" />

                                            <Button
                                                Padding="0"
                                                BackgroundColor="#F1F5F9"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.StampaRicevutaCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontSize="13"
                                                HeightRequest="32"
                                                Text="🖨️"
                                                WidthRequest="32" />

                                            <Button
                                                Padding="0"
                                                BackgroundColor="#E2E8F0"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleSospensioneAbbonamentoCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontSize="13"
                                                HeightRequest="32"
                                                Text="{Binding IconaPausaTesto}"
                                                WidthRequest="32" />

                                            <Button
                                                Padding="0"
                                                BackgroundColor="#FEF9C3"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DiminuisciSettimanaAbbonamentoCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                HeightRequest="32"
                                                Text="-7g"
                                                TextColor="#92400E"
                                                WidthRequest="32" />

                                            <Button
                                                Padding="0"
                                                BackgroundColor="#DCFCE7"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AumentaSettimanaAbbonamentoCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontAttributes="Bold"
                                                FontSize="10"
                                                HeightRequest="32"
                                                Text="+7g"
                                                TextColor="#166534"
                                                WidthRequest="32" />

                                            <Button
                                                Padding="0"
                                                BackgroundColor="#DBEAFE"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RinnovaAbbonamentoCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontSize="13"
                                                HeightRequest="32"
                                                Text="🔄"
                                                WidthRequest="32" />

                                            <Button
                                                Padding="0"
                                                BackgroundColor="#FEE2E2"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EliminaAbbonamentoCommand}"
                                                CommandParameter="{Binding .}"
                                                CornerRadius="16"
                                                FontSize="13"
                                                HeightRequest="32"
                                                Text="🗑️"
                                                WidthRequest="32" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView BackgroundColor="#E2E8F0" HeightRequest="1" />

                    <!--  BARRA DI PAGINAZIONE  -->
                    <Grid
                        Padding="12,8"
                        BackgroundColor="#F8FAFC"
                        ColumnDefinitions="Auto, *, Auto">
                        <Button
                            Grid.Column="0"
                            Padding="10,0"
                            BackgroundColor="#E2E8F0"
                            Command="{Binding PaginaPrecedenteCommand}"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="32"
                            IsEnabled="{Binding HaPaginaPrecedente}"
                            Text="◀ Precedente"
                            TextColor="#1E293B" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="{Binding TestoPaginazione}"
                            TextColor="#475569"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="2"
                            Padding="10,0"
                            BackgroundColor="#E2E8F0"
                            Command="{Binding PaginaSuccessivaCommand}"
                            CornerRadius="6"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="32"
                            IsEnabled="{Binding HaPaginaSuccessiva}"
                            Text="Successivo ▶"
                            TextColor="#1E293B" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--  PULSANTI SALVA / PRIVACY / ELIMINA ALLIEVO  -->
            <Grid
                Margin="0,10,0,0"
                ColumnDefinitions="*, Auto"
                ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    BackgroundColor="#10B981"
                    Command="{Binding SalvaAllievoCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="46"
                    Text="Salva Allievo"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    BackgroundColor="#6366F1"
                    Command="{Binding ApriDocumentoPrivacyCommand}"
                    CornerRadius="8"
                    FontSize="20"
                    HeightRequest="46"
                    IsVisible="{Binding MostraBottonePrivacy}"
                    Text="📄"
                    WidthRequest="56" />
            </Grid>

            <!--  STATO DEL MODULO PRIVACY  -->
            <Border
                Padding="12"
                BackgroundColor="White"
                IsVisible="{Binding MostraStatoPrivacy}"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding StatoPrivacyTesto}"
                        TextColor="{Binding StatoPrivacyColore}" />

                    <Button
                        BackgroundColor="#10B981"
                        Command="{Binding ConfermaFirmaPrivacyCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        IsVisible="{Binding MostraBottoneFirma}"
                        Text="✍️ Segna come firmato"
                        TextColor="White" />

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        IsVisible="{Binding PrivacyFirmata}">
                        <Button
                            Grid.Column="0"
                            BackgroundColor="#0EA5E9"
                            Command="{Binding ApriPdfPrivacyCommand}"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="42"
                            IsVisible="{Binding HaPdfArchiviato}"
                            Text="📂 Apri PDF archiviato"
                            TextColor="White" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="#64748B"
                            Command="{Binding AnnullaFirmaPrivacyCommand}"
                            CornerRadius="8"
                            FontSize="12"
                            HeightRequest="42"
                            Text="Annulla firma"
                            TextColor="White"
                            WidthRequest="120" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button
                BackgroundColor="#EF4444"
                Command="{Binding EliminaAllievoCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="46"
                IsVisible="{Binding IsEdizione}"
                Text="Elimina Allievo"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>