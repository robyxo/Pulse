<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.NotifichePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:Pulse.DTO"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    x:Name="PageRoot"
    Title="Notifiche"
    x:DataType="vm:NotificheViewModel"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="📨 Invia Notifica agli Allievi" />

            <Label
                FontSize="13"
                Text="Il messaggio verrà inviato via email a tutti gli allievi attivi che hanno un indirizzo email salvato."
                TextColor="Gray" />

            <Label
                FontAttributes="Bold"
                Text="Oggetto:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="42"
                    Placeholder="Oggetto dell'email"
                    Text="{Binding Oggetto}" />
            </Border>

            <Label
                FontAttributes="Bold"
                Text="Messaggio:"
                TextColor="#1E293B" />
            <Border
                Padding="10"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Editor
                    AutoSize="TextChanges"
                    HeightRequest="180"
                    Placeholder="Scrivi qui il messaggio da inviare..."
                    Text="{Binding Messaggio}" />
            </Border>

            <Button
                Margin="0,10,0,0"
                BackgroundColor="#F59E0B"
                Command="{Binding InviaNotificaCommand}"
                CornerRadius="12"
                FontAttributes="Bold"
                HeightRequest="50"
                Text="📨 Invia Notifica"
                TextColor="White" />

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <!--  STORICO COMUNICAZIONI INVIATE  -->
            <BoxView
                Margin="0,10"
                BackgroundColor="#E2E8F0"
                HeightRequest="1" />

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="🗂️ Comunicazioni inviate" />

            <Label
                FontSize="13"
                IsVisible="{Binding NessunaComunicazione}"
                Text="Nessuna comunicazione registrata finora."
                TextColor="Gray" />

            <CollectionView ItemsSource="{Binding ListaComunicazioni}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ComunicazioneRigaDTO">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.MostraDettaglioCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Oggetto}"
                                    TextColor="#1E293B" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding EsitoIcona}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Anteprima}"
                                    TextColor="#64748B" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    TextColor="#94A3B8">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DataTesto}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding DestinatariTesto}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>