<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.CalendarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Calendario"
    x:DataType="vm:CalendarioViewModel"
    BackgroundColor="#F3F4F6">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <VerticalStackLayout
            Grid.Row="0"
            Padding="10,8"
            BackgroundColor="White"
            Spacing="8">

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button
                    BackgroundColor="#4F46E5"
                    Command="{Binding SettimanaPrecedenteCommand}"
                    CornerRadius="8"
                    HeightRequest="40"
                    Text="◀"
                    TextColor="White"
                    WidthRequest="40" />
                <Button
                    Padding="15,0"
                    BackgroundColor="#10B981"
                    Command="{Binding VaiOggiCommand}"
                    CornerRadius="8"
                    HeightRequest="40"
                    Text="📅 Oggi"
                    TextColor="White" />
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Text="{Binding SettimanaCorrente, StringFormat='{0:dd MMM yyyy}'}"
                    VerticalOptions="Center"
                    WidthRequest="140" />
                <Button
                    BackgroundColor="#4F46E5"
                    Command="{Binding SettimanaSuccessivaCommand}"
                    CornerRadius="8"
                    HeightRequest="40"
                    Text="▶"
                    TextColor="White"
                    WidthRequest="40" />
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Label
                    FontAttributes="Bold"
                    Text="Dalle:"
                    VerticalOptions="Center" />
                <TimePicker Time="{Binding OraInizio}" WidthRequest="90" />
                <Label
                    FontAttributes="Bold"
                    Text="Alle:"
                    VerticalOptions="Center" />
                <TimePicker Time="{Binding OraFine}" WidthRequest="90" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <ScrollView
            Grid.Row="2"
            HorizontalOptions="Fill"
            Orientation="Vertical"
            VerticalOptions="Fill">
            <Grid
                x:Name="CalendarioGrid"
                Padding="2"
                BackgroundColor="White"
                ColumnSpacing="1"
                HorizontalOptions="Fill"
                RowSpacing="1"
                VerticalOptions="Fill" />
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="3"
            Padding="10"
            BackgroundColor="White">
            <Button
                BackgroundColor="Transparent"
                Clicked="OnToggleMenuClicked"
                Text="▼ Menu Azioni"
                TextColor="Gray" />
            <VerticalStackLayout
                x:Name="MenuVoci"
                IsVisible="False"
                Spacing="5">

                <Button
                    BackgroundColor="#0284C7"
                    Command="{Binding NavigaGestioneInsegnantiCommand}"
                    FontAttributes="Bold"
                    Text="👨‍🏫 Gestione Insegnanti"
                    TextColor="White" />

                <Button
                    BackgroundColor="#4F46E5"
                    Command="{Binding NavigaGestioneCorsiCommand}"
                    FontAttributes="Bold"
                    Text="📚 Gestione Corsi"
                    TextColor="White" />

            </VerticalStackLayout>
        </VerticalStackLayout>

        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>