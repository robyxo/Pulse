<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.CalendarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Calendario"
    x:DataType="vm:CalendarioViewModel"
    BackgroundColor="#F3F4F6">

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout
            Grid.Row="0"
            Padding="10,8"
            BackgroundColor="White"
            Spacing="8">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button
                    BackgroundColor="#4F46E5"
                    Command="{Binding SettimanaPrecedenteCommand}"
                    CornerRadius="8"
                    HeightRequest="40"
                    Text="◀"
                    TextColor="White"
                    WidthRequest="40" />
                <Button
                    Padding="15,0"
                    BackgroundColor="#10B981"
                    Command="{Binding VaiOggiCommand}"
                    CornerRadius="8"
                    HeightRequest="40"
                    Text="📅 Oggi"
                    TextColor="White" />
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Text="{Binding SettimanaCorrente, StringFormat='{0:dd MMM yyyy}'}"
                    VerticalOptions="Center"
                    WidthRequest="140" />
                <Button
                    BackgroundColor="#4F46E5"
                    Command="{Binding SettimanaSuccessivaCommand}"
                    CornerRadius="8"
                    HeightRequest="40"
                    Text="▶"
                    TextColor="White"
                    WidthRequest="40" />
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                <Label Text="Intervallo:" VerticalOptions="Center" />
                <Picker
                    ItemsSource="{Binding IntervalliDisponibili}"
                    SelectedItem="{Binding IntervalloMinuti}"
                    WidthRequest="70" />
                <Label Text="min" VerticalOptions="Center" />
                <CheckBox IsChecked="{Binding MostraSoloAttive}" />
                <Label Text="Nascondi pause" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2" Orientation="Both">
            <Grid
                x:Name="CalendarioGrid"
                Padding="2"
                BackgroundColor="White"
                ColumnSpacing="1"
                RowSpacing="1" />
        </ScrollView>

        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>