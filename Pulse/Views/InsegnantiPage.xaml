<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.InsegnantiPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Pulse.Models"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    x:Name="PageRoot"
    Title="Gestione Insegnanti"
    x:DataType="vm:InsegnantiViewModel"
    BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        <Border
            Grid.Row="0"
            Margin="15,15,15,10"
            BackgroundColor="Transparent"
            StrokeShape="RoundRectangle 8">
            <Button
                BackgroundColor="#10B981"
                Command="{Binding NuovoInsegnanteCommand}"
                FontAttributes="Bold"
                HeightRequest="48"
                Text="+ Nuovo Insegnante"
                TextColor="White" />
        </Border>

        <CollectionView
            Grid.Row="1"
            Margin="15,0,15,15"
            ItemsSource="{Binding ListaInsegnanti}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Margin="0,50,0,0"
                    HorizontalOptions="Center"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Label
                        FontSize="40"
                        HorizontalOptions="Center"
                        Text="👨‍🏫" />
                    <Label
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="Nessun insegnante presente."
                        TextColor="#64748B" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <!--  🟢 Cambiamo x:DataType in x:Object per sbloccare il binding verso il ViewModel  -->
                <DataTemplate x:DataType="x:Object">
                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 10">
                        <Grid
                            ColumnDefinitions="Auto, *, Auto, Auto"
                            ColumnSpacing="12"
                            VerticalOptions="Center">

                            <Label
                                Grid.Column="0"
                                FontSize="20"
                                Text="👤"
                                VerticalOptions="Center" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    TextColor="#1E293B">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Nome}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Cognome}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Telefono, StringFormat='📞 {0}'}"
                                    TextColor="#64748B" />
                            </VerticalStackLayout>

                            <!--  PULSANTE MODIFICA  -->
                            <Button
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="#F1F5F9"
                                Command="{Binding BindingContext.ModificaInsegnanteCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}"
                                CornerRadius="18"
                                FontSize="16"
                                HeightRequest="36"
                                Text="✏️"
                                WidthRequest="36" />

                            <!--  PULSANTE ELIMINA  -->
                            <Button
                                Grid.Column="3"
                                Padding="0"
                                BackgroundColor="#FEE2E2"
                                Command="{Binding BindingContext.EliminaInsegnanteCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}"
                                CornerRadius="18"
                                FontSize="16"
                                HeightRequest="36"
                                Text="🗑️"
                                WidthRequest="36" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.RowSpan="2"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>