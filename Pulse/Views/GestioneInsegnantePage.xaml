<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.GestioneInsegnantePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:Pulse.DTO"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Gestione Insegnante"
    x:DataType="vm:GestioneInsegnanteViewModel"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                FontAttributes="Bold"
                Text="Nome:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="45"
                    Placeholder="Es. Marco"
                    Text="{Binding Nome}" />
            </Border>

            <Label
                FontAttributes="Bold"
                Text="Cognome:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="45"
                    Placeholder="Es. Rossi"
                    Text="{Binding Cognome}" />
            </Border>

            <Label
                FontAttributes="Bold"
                Text="Telefono:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="45"
                    Keyboard="Telephone"
                    Placeholder="Es. +39 333 1234567"
                    Text="{Binding Telefono}" />
            </Border>

            <Label
                FontAttributes="Bold"
                Text="Email:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="45"
                    Keyboard="Email"
                    Placeholder="Es. marco.rossi@email.com"
                    Text="{Binding Email}" />
            </Border>
            <!--  FUNZIONE MAESTRO AVANZATA  -->
            <VerticalStackLayout IsVisible="{Binding FunzioneMaestroAvanzataAttiva}" Spacing="14">

                <BoxView Margin="0,6" HeightRequest="1" BackgroundColor="#E2E8F0" />

                <Label FontAttributes="Bold" Text="Tariffa Oraria (€):" TextColor="#1E293B" />
                <Border Padding="10,0" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8">
                    <Entry HeightRequest="42" Keyboard="Numeric" Placeholder="0,00" Text="{Binding TariffaOraria, StringFormat='{0:N2}'}" />
                </Border>

                <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">

                        <Label FontAttributes="Bold" FontSize="16" Text="📊 Riepilogo Ore e Compensi" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label FontSize="12" Text="Mese" TextColor="#64748B" />
                                <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8">
                                    <Picker ItemsSource="{Binding NomiMesi}" SelectedIndex="{Binding MeseSelezionatoIndex}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label FontSize="12" Text="Anno" TextColor="#64748B" />
                                <Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8">
                                    <Picker ItemsSource="{Binding AnniDisponibili}" SelectedItem="{Binding AnnoSelezionato}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Grid.Column="0" Padding="10" BackgroundColor="#F0FDF4" Stroke="#BBF7D0" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label FontSize="11" HorizontalOptions="Center" Text="Settimana" TextColor="#166534" />
                                    <Label FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Text="{Binding OreSettimanali, StringFormat='{0:0.##} h'}" TextColor="#166534" />
                                    <Label FontSize="12" HorizontalOptions="Center" Text="{Binding CompensoSettimanale, StringFormat='€ {0:N2}'}" TextColor="#166534" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Padding="10" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label FontSize="11" HorizontalOptions="Center" Text="Mese" TextColor="#1E40AF" />
                                    <Label FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Text="{Binding OreMese, StringFormat='{0:0.##} h'}" TextColor="#1E40AF" />
                                    <Label FontSize="12" HorizontalOptions="Center" Text="{Binding CompensoMese, StringFormat='€ {0:N2}'}" TextColor="#1E40AF" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Padding="10" BackgroundColor="#FDF4FF" Stroke="#F5D0FE" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label FontSize="11" HorizontalOptions="Center" Text="Anno" TextColor="#86198F" />
                                    <Label FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" Text="{Binding OreAnno, StringFormat='{0:0.##} h'}" TextColor="#86198F" />
                                    <Label FontSize="12" HorizontalOptions="Center" Text="{Binding CompensoAnno, StringFormat='€ {0:N2}'}" TextColor="#86198F" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label FontSize="11" Text="Il conteggio di mese e anno è calcolato sull'orario settimanale ricorrente, escludendo i periodi di Chiusura registrati in Calendario Eventi." TextColor="Gray" />

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                        <Label FontAttributes="Bold" Text="Corsi e Orari Assegnati" TextColor="#1E293B" />

                        <CollectionView ItemsSource="{Binding ListaLezioniAssegnate}">
                            <CollectionView.EmptyView>
                                <Label Margin="0,10" HorizontalOptions="Center" Text="Nessun corso assegnato a questo insegnante." TextColor="Gray" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:LezioneMaestroDTO">
                                    <Grid Padding="0,8" ColumnDefinitions="2*,1.2*,1.5*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" FontAttributes="Bold" FontSize="13" Text="{Binding NomeCorso}" TextColor="#1E293B" VerticalOptions="Center" />
                                        <Label Grid.Column="1" FontSize="12" Text="{Binding GiornoTesto}" TextColor="#64748B" VerticalOptions="Center" />
                                        <Label Grid.Column="2" FontSize="12" Text="{Binding OrarioTesto}" TextColor="#64748B" VerticalOptions="Center" />
                                        <Label Grid.Column="3" FontAttributes="Bold" FontSize="12" Text="{Binding DurataTesto}" TextColor="#4F46E5" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button
                Margin="0,15,0,0"
                BackgroundColor="#10B981"
                Command="{Binding SalvaInsegnanteCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="48"
                Text="Salva Insegnante"
                TextColor="White" />

            <Button
                BackgroundColor="#EF4444"
                Command="{Binding EliminaInsegnanteCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="48"
                IsVisible="{Binding IsEdizione}"
                Text="Elimina Insegnante"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>