<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.GestioneCorsoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Gestione Corso"
    x:DataType="vm:GestioneCorsoViewModel"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!--  NOME CORSO  -->
            <Label
                FontAttributes="Bold"
                Text="Nome Corso:"
                TextColor="#1E293B" />
            <Border
                Padding="10,0"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Entry
                    HeightRequest="45"
                    Placeholder="Es. Salsa Principianti"
                    Text="{Binding Nome}" />
            </Border>

            <!--  DESCRIZIONE  -->
            <Label
                FontAttributes="Bold"
                Text="Descrizione:"
                TextColor="#1E293B" />
            <Border
                Padding="10"
                Stroke="#CBD5E1"
                StrokeShape="RoundRectangle 8">
                <Editor
                    HeightRequest="80"
                    Placeholder="Inserisci dettagli del corso..."
                    Text="{Binding Descrizione}" />
            </Border>

            <!--  PREZZI ABBONAMENTO  -->
            <Label
                FontAttributes="Bold"
                Text="Prezzi Abbonamento (€):"
                TextColor="#1E293B" />

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                <!--  Singolo  -->
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label
                        FontSize="12"
                        Text="Singolo"
                        TextColor="#64748B" />
                    <Border
                        Padding="8,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="40"
                            Keyboard="Numeric"
                            Placeholder="0,00"
                            Text="{Binding CostoSingolo, StringFormat='{0:N2}'}" />
                    </Border>
                </VerticalStackLayout>

                <!--  Mensile  -->
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label
                        FontSize="12"
                        Text="Mensile"
                        TextColor="#64748B" />
                    <Border
                        Padding="8,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="40"
                            Keyboard="Numeric"
                            Placeholder="0,00"
                            Text="{Binding CostoMensile, StringFormat='{0:N2}'}" />
                    </Border>
                </VerticalStackLayout>

                <!--  Annuale  -->
                <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Label
                        FontSize="12"
                        Text="Annuale"
                        TextColor="#64748B" />
                    <Border
                        Padding="8,0"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 8">
                        <Entry
                            HeightRequest="40"
                            Keyboard="Numeric"
                            Placeholder="0,00"
                            Text="{Binding CostoAnnuale, StringFormat='{0:N2}'}" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!--  COLORE IDENTIFICATIVO  -->
            <Label
                FontAttributes="Bold"
                Text="Colore identificativo:"
                TextColor="#1E293B" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border
                    BackgroundColor="{Binding ColoreHex}"
                    HeightRequest="40"
                    Stroke="#CBD5E1"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" />
                <Label
                    FontSize="12"
                    Text="Scegli uno dei colori qui sotto"
                    TextColor="#64748B"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <FlexLayout
                AlignItems="Center"
                Direction="Row"
                JustifyContent="Start"
                Wrap="Wrap">
                <Button
                    Margin="3"
                    BackgroundColor="#4F46E5"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#4F46E5"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#10B981"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#10B981"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#EF4444"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#EF4444"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#F59E0B"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#F59E0B"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#EC4899"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#EC4899"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#0EA5E9"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#0EA5E9"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
            </FlexLayout>

            <!--  COLORE TESTO CORSO  -->
            <Label
                FontAttributes="Bold"
                Text="Colore testo corso:"
                TextColor="#1E293B" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border
                    Padding="12,0"
                    BackgroundColor="{Binding ColoreHex}"
                    HeightRequest="40"
                    Stroke="#CBD5E1"
                    StrokeShape="RoundRectangle 8"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Text="Anteprima"
                        TextColor="{Binding ColoreTestoHex}"
                        VerticalOptions="Center" />
                </Border>

                <Button
                    BackgroundColor="#1E293B"
                    Command="{Binding SelezionaColoreTestoCommand}"
                    CommandParameter="#000000"
                    CornerRadius="8"
                    FontSize="12"
                    HeightRequest="40"
                    Text="⚫ Nero"
                    TextColor="White"
                    WidthRequest="90" />

                <Button
                    BackgroundColor="#1E293B"
                    Command="{Binding SelezionaColoreTestoCommand}"
                    CommandParameter="#FFFFFF"
                    CornerRadius="8"
                    FontSize="12"
                    HeightRequest="40"
                    Text="⚪ Bianco"
                    TextColor="White"
                    WidthRequest="90" />
            </HorizontalStackLayout>

            <Label
                FontSize="12"
                Text="Scegli un colore rapido:"
                TextColor="#64748B" />

            <FlexLayout
                AlignItems="Center"
                Direction="Row"
                JustifyContent="Start"
                Wrap="Wrap">
                <Button
                    Margin="3"
                    BackgroundColor="#EDFF21"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#EDFF21"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#00913F"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#00913F"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#FF6088"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#FF6088"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#FF0000"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#FF0000"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#0000FF"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#0000FF"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#FF00FF"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#FF00FF"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Button
                    Margin="3"
                    BackgroundColor="#4F46E5"
                    Command="{Binding SelezionaColorePresetCommand}"
                    CommandParameter="#4F46E5"
                    CornerRadius="18"
                    HeightRequest="36"
                    WidthRequest="36" />
            </FlexLayout>

            <!--  PULSANTI AZIONE  -->
            <Button
                Margin="0,15,0,0"
                BackgroundColor="#10B981"
                Command="{Binding SalvaCorsoCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="48"
                Text="Salva Corso"
                TextColor="White" />

            <Button
                BackgroundColor="#EF4444"
                Command="{Binding EliminaCorsoCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="48"
                IsVisible="{Binding IsEdizione}"
                Text="Elimina Corso"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>