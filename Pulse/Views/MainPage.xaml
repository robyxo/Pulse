<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Home"
    x:DataType="vm:MainViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Contenuto principale centrato  -->
        <VerticalStackLayout
            Grid.Row="0"
            HorizontalOptions="Center"
            Spacing="20"
            VerticalOptions="Center">

            <Image
                Aspect="AspectFit"
                HeightRequest="90"
                HorizontalOptions="Center"
                IsVisible="{Binding MostraLogo}"
                Source="{Binding LogoScuola}" />

            <Label
                FontSize="60"
                HorizontalOptions="Center"
                IsVisible="{Binding MostraEmojiDefault}"
                Text="👋" />

            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="{Binding MessaggioBenvenuto}"
                TextColor="#1A1A1A" />

            <Label
                FontSize="18"
                HorizontalOptions="Center"
                Text="{Binding Sottotitolo}"
                TextColor="#6B7280" />

        </VerticalStackLayout>

        <!--  Pulsante per andare al Calendario  -->
        <Button
            Grid.Row="1"
            Margin="20,0,20,30"
            BackgroundColor="#4F46E5"
            Command="{Binding VaiAlCalendarioCommand}"
            CornerRadius="12"
            FontSize="18"
            HeightRequest="60"
            HorizontalOptions="Center"
            Text="📅 Vedi Calendario"
            TextColor="White"
            WidthRequest="250" />
    </Grid>

</ContentPage>