<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.ImpostazioniPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Impostazioni"
    x:DataType="vm:ImpostazioniViewModel"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="⚙️ Impostazioni" />

            <!--  SEZIONE: VISTA CALENDARIO  -->
            <Border
                Padding="16"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="🗓️ Vista Calendario" />

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label FontAttributes="Bold" Text="Orario Scaglionato" />
                            <Label
                                FontSize="12"
                                Text="Se attivo, il Calendario mostra fasce orarie precise invece delle bande Mattina/Pomeriggio/Sera."
                                TextColor="Gray" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding OrarioScaglionatoAttivo}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  SEZIONE: RICEVUTE  -->
            <Border
                Padding="16"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="🧾 Ricevute" />

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label FontAttributes="Bold" Text="Stampa Ricevuta di Cortesia" />
                            <Label
                                FontSize="12"
                                Text="Se attivo, dopo ogni incasso viene proposta la stampa della ricevuta di cortesia."
                                TextColor="Gray" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding StampaRicevutaCortesiaAttiva}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  SEZIONE: DOCUMENTO PRIVACY  -->
            <Border
                Padding="16"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="🔒 Documento Privacy" />

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label FontAttributes="Bold" Text="Stampa Documento Privacy" />
                            <Label
                                FontSize="12"
                                Text="Se disattivo, il bottone 📄 per il documento privacy sparisce dalla scheda Allievo."
                                TextColor="Gray" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding StampaDocumentoPrivacyAttiva}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  PULSANTE SALVA  -->
            <Button
                BackgroundColor="#10B981"
                Command="{Binding SalvaImpostazioniCommand}"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="46"
                Text="💾 Salva Impostazioni"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>