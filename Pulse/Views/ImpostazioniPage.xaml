<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pulse.Views.ImpostazioniPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Pulse.ViewModels"
    Title="Impostazioni"
    x:DataType="vm:ImpostazioniViewModel"
    BackgroundColor="#F8FAFC">

    <VerticalStackLayout
        Padding="20"
        HorizontalOptions="Center"
        Spacing="15"
        VerticalOptions="Center">

        <Label
            FontSize="50"
            HorizontalOptions="Center"
            Text="⚙️" />

        <Label
            FontAttributes="Bold"
            FontSize="24"
            HorizontalOptions="Center"
            Text="Impostazioni" />

        <Label
            FontSize="15"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Text="Sezione in costruzione: qui troverai a breve i dati della scuola e le altre configurazioni."
            TextColor="Gray" />

    </VerticalStackLayout>
</ContentPage>